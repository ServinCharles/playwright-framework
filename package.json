{
  "name": "playwright-ai-framework",
  "version": "2.0.0",
  "description": "Playwright + TypeScript test framework with API tests, AI evaluation, and an AI test generator with a human review gate",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api",
    "test:unit": "playwright test --project=unit",
    "test:ai-eval": "playwright test --project=ai-eval",
    "chat-api": "tsx mock-chat-api/server.ts",
    "eval": "tsx ai/eval/run-eval.ts",
    "eval:live": "EVAL_LIVE=1 JUDGE=1 tsx ai/eval/run-eval.ts",
    "redteam": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c promptfooconfig.yaml --no-cache -o reports/redteam/results.json",
    "ai:generate": "tsx ai/generator/cli.ts",
    "ai:promote": "tsx ai/review/promote.ts",
    "ai:stats": "tsx ai/review/stats.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:api && npm run test:ai-eval && npm run eval",
    "report": "playwright show-report",
    "chat-service": "tsx chat-service/server.ts",
    "eval:calibrate": "tsx ai/eval/calibrate.ts",
    "agent-service": "tsx agent/server.ts",
    "mcp": "tsx mcp/stdio.ts",
    "demo:traces": "tsx observability/demo.ts",
    "dashboard": "tsx observability/dashboard.ts",
    "redteam:html": "PROMPTFOO_DISABLE_TELEMETRY=1 promptfoo eval -c promptfooconfig.yaml --no-cache -o reports/redteam/report.html"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "promptfoo": "^0.125.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.3",
    "@azure/msal-node": "^7.1.1"
  }
}
