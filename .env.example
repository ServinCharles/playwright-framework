# Copy to .env and fill in. Never commit .env.

# Where the app under test lives
BASE_URL=https://www.saucedemo.com
# Chat API under test. Leave this commented out to use the built-in local mock.
# Set it only to point at a real service on another machine.
# CHAT_API_URL=https://your-chat-service.example.com

# BrowserStack (only needed when execution=cloud)
execution=local
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# AI test generator (only needed for --provider anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Chat service (npm run chat-service) and agent (npm run agent-service)
# Without ANTHROPIC_API_KEY both use a scripted stand-in model, which is fine locally.
# In production (NODE_ENV=production) the chat service refuses to start without a key.

# Tracing: write spans to a file for the dashboard, and/or send to an OTLP backend
# TRACE_FILE=reports/traces/spans.jsonl
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Signed escalation webhook (both are needed together)
# WEBHOOK_URL=https://hooks.example.com/escalations
# WEBHOOK_SECRET=a-long-random-string

# Service API key. Set SERVICE_API_KEY on a server to require it on POST requests,
# and CHAT_API_KEY on the test side to send it. Leave both unset for local development.
# SERVICE_API_KEY=
# CHAT_API_KEY=
