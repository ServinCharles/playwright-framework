# Copy to .env and fill in. Never commit .env.

# Where the app under test lives
BASE_URL=https://www.saucedemo.com
# Chat API under test. Defaults to the local mock started by `npm run chat-api`

# BrowserStack (only needed when execution=cloud)
execution=local
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# AI test generator (only needed for --provider anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
